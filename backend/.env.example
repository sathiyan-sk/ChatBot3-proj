# ─────────────────────────────────────────────────────────────────────────────
# Example environment configuration for the backend.
# Copy to `.env` and adjust values for your deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Document parsing ─────────────────────────────────────────────────────────
# PDF/DOCX ingestion strategy:
#   docling  — Docling layout/OCR provider (default).
#   native   — PyMuPDF text-only provider; image-only PDFs are rejected.
#   auto     — Opt-in per-document selection: PyMuPDF extracts the text layer
#              first, then Docling OCR runs only on pages that have no
#              recoverable selectable text. Recommended for mixed
#              text/scanned PDFs; the default remains `docling`.
DOCUMENT_PARSER_PROVIDER=auto

# Only consulted when DOCUMENT_PARSER_PROVIDER=auto. When PyMuPDF extracts a
# PDF, the fraction of pages with selectable text is computed. At or above this
# threshold the fast text-layer result is used directly; below it the
# image-only pages are sent to Docling for selective OCR (and a full Docling
# pass runs on any selective-OCR failure). Values in [0.0, 1.0]; invalid
# values fail startup validation.
#   0.0 -> always OCR image-only pages; 1.0 -> OCR only when no page has text.
SELECTABLE_TEXT_RATIO_THRESHOLD=0.5

# Docling OCR tuning (consulted by the full-OCR and selective-OCR paths).
# Prewarm the layout + OCR models at deploy time and set DOCLING_ARTIFACTS_PATH
# to that directory for offline runs; leave blank to let Docling download and
# cache models to its default location (this download is the most common cause
# of ingestion timeouts on first use, because each ingestion runs in a fresh
# subprocess).
DOCLING_ARTIFACTS_PATH=/var/lib/docling/artifacts   # Docling's compiled onnx artifacts (MUST be persistent+shared)
HF_HOME=/var/lib/docling/hf_cache              # HuggingFace download cache for Docling models (MUST be persistent+shared)


# RapidOCR language (one code, e.g. en, ch, de). Default: en.
DOCLING_OCR_LANGUAGE=en
# Raster DPI used by selective page OCR. Lower (e.g. 100) to speed up OCR on
# large scanned images; 144 is a good default.
DOCLING_OCR_IMAGE_DPI=144
# RapidOCR mode. Valid in Docling 2.118.0:
#   default | full_page | layout_regions | pdf_aware_layout_regions
# default = layout-aware OCR (recommended). NOTE: 'accurate' and 'skip' are
# NOT valid OcrMode values in 2.118.0 — setting them falls back to default
# (with a warning). To disable OCR entirely, use DOCUMENT_PARSER_PROVIDER=native.
DOCLING_OCR_MODE=default
# Skip Docling's layout-detection model for faster OCR on scanned/image-only
# PDFs (e.g. Aadhaar cards): text is still fully OCR'd, but no section/table
# structure is produced. Recommended for ingestion-only workloads that only
# need searchable text. Set to empty/0 (default) to keep layout-aware extraction.
DOCLING_SKIP_LAYOUT=1
# ── App ────────────────────────────────────────────────────────────────
APP_NAME=AI Knowledge Platform Backend
HTTP_USER_AGENT=AI-Knowledge-Platform/1.0
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# The deployed admin frontend origin must be included here (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Also set this on Render; settings.py merges it into global CORS.
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_LOCAL_ORIGINS=true
CHAT_HISTORY_RETENTION_DAYS=30
INGESTION_STALE_AFTER_MINUTES=120
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
CLIENT_ALLOWED_ORIGINS=http://localhost:5173
WIDGET_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (PostgreSQL / Supabase) ───────────────────────────────────
# Used by app/config/settings.py -> DatabaseSettings.url
#
# Supabase gives you THREE connection strings (Dashboard > Project Settings
# > Database > Connection string). For this SQLAlchemy backend use ONE of:
#
# 1) SESSION POOLER (recommended - works on IPv4 networks, supports
#    SQLAlchemy connection pooling). Port 5432, username is
#    "postgres.<project-ref>":
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:YOUR-PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# 2) DIRECT connection (only if your network supports IPv6 - newer Supabase
#    projects are IPv6-only on db.* hosts):
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR-PASSWORD@db.<project-ref>.supabase.co:5432/postgres
#
# 3) TRANSACTION pooler (port 6543) - NOT recommended with SQLAlchemy's
#    default pooling (prepared statements break through PgBouncer).
#
# Notes:
# - The password is your DATABASE password (Project Settings > Database),
#   NOT the service-role JWT. URL-encode special chars (@ -> %40 etc).
# - Driver must be psycopg2: use "postgresql+psycopg2://" prefix.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_knowledge_platform

# ── Admin Basic Auth (used by /api/admin/* endpoints) ──────────────────
ADMIN_USERNAME=replace-with-a-unique-admin-name
ADMIN_PASSWORD=replace-with-a-long-random-password

# ── Provider selection (values read by app/config/settings.py) ────────
# LLM_PROVIDER:        ollama | openrouter
# EMBEDDING_PROVIDER:  ollama | openrouter | huggingface | openai
# VECTOR_PROVIDER:     pgvector
# STORAGE_PROVIDER:    supabase
# Document-parsing vars (DOCUMENT_PARSER_PROVIDER, SELECTABLE_TEXT_RATIO_
# THRESHOLD, and the DOCLING_* knobs) live in the "Document parsing" section
# above so each key is defined exactly once.
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=ollama
VECTOR_PROVIDER=pgvector
STORAGE_PROVIDER=supabase
MAX_UPLOAD_FILE_SIZE_BYTES=20971520
MAX_PDF_PAGES=50

# ── Ollama (local provider option) ─────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=qwen2.5:3b
EMBEDDING_MODEL_NAME=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# ── OpenRouter (cloud provider option) ─────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Alternatives: qwen/qwen-2.5-7b-instruct (chat), openai/text-embedding-3-small (embed, 1536 dims)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_EMBEDDING_DIMENSIONS=1024
# Each request processes at most 64 chunks; lower this if the selected model has stricter limits.
OPENROUTER_EMBEDDING_BATCH_SIZE=64
OPENROUTER_TIMEOUT_SECONDS=60

# ── Hugging Face Inference Providers (embedding-only option) ───────────
HF_TOKEN=
HF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
HF_INFERENCE_PROVIDER=hf-inference
HF_EMBEDDING_BATCH_SIZE=32
HF_INFERENCE_TIMEOUT_SECONDS=60

# ── OpenAI embeddings (LLM provider remains separately configured) ─────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_EMBEDDING_BATCH_SIZE=32
OPENAI_EMBEDDING_TIMEOUT_SECONDS=60

# ── Supabase Storage (REQUIRED for document upload) ────────────────────
# NOTE: settings.py reads SUPABASE_URL / SUPABASE_BUCKET_NAME /
# SUPABASE_SERVICE_ROLE_KEY. The service-role key is required because the
# backend bypasses RLS when writing to the bucket.
SUPABASE_URL=
SUPABASE_BUCKET_NAME=data_files
SUPABASE_SERVICE_ROLE_KEY=

# ── Vector store (pgvector) ────────────────────────────────────────────
# Must match the embedding model output dimension:
#   nomic-embed-text (Ollama)        -> 768
#   qwen3-embedding-8b (OpenRouter)  -> 1024 (or as configured)
#   BAAI/bge-large-en-v1.5 (Hugging Face) -> 1024
#   text-embedding-3-small (OpenAI)  -> 1024 (configured output dimension)
VECTOR_STORE_TABLE_NAME=document_chunks
VECTOR_STORE_DIMENSION=1024

# ── Timeouts ───────────────────────────────────────────────────────────
PROVIDER_TIMEOUT_SECONDS=30
INGESTION_TIMEOUT_SECONDS=900
INGESTION_LEASE_SECONDS=120
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_SECONDS=30
INGESTION_RETRY_MAX_SECONDS=300

# ── Optional LangSmith tracing ────────────────────────────────────────
# Disabled by default. When enabled, chat prompts/responses and retrieved
# context can be sent to LangSmith; enable only for data approved for tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Optional self-hosted/custom LangSmith API endpoint.
LANGSMITH_ENDPOINT=
